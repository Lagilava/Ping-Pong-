# Auto detect binary files and normalize line endings
* text=auto

# Binary files
*.wasm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp3 binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
*.eot binary
*.woff binary
*.woff2 binary

# Web stuff that should be text
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Source files
*.cpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.hpp text eol=lf

# Windows launcher scripts must keep CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
